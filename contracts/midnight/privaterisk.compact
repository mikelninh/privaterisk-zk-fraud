pragma language_version >= 0.22 && <= 0.23;
import CompactStandardLibrary;

// PrivateRisk V0.2
// Prove that a private balance is sufficient for a specific transfer
// without revealing the raw balance. The request id and transfer amount
// are disclosed to bind the proof to an explicit policy context and prevent
// replay of the same request.

witness privateBalance(): Uint<64>;

export ledger verifiedRequests: Set<Bytes<32>>;
export ledger proofCount: Counter;

export circuit proveBalanceForTransfer(
  requestId: Bytes<32>,
  transferAmount: Uint<64>
): [] {
  const publicRequestId = disclose(requestId);
  const publicTransferAmount = disclose(transferAmount);

  assert(
    !verifiedRequests.member(publicRequestId),
    "PrivateRisk request has already been used"
  );

  const balance = privateBalance();
  assert(
    balance >= publicTransferAmount,
    "Private balance is below the transfer amount"
  );

  verifiedRequests.insert(publicRequestId);
  proofCount.increment(1);
}
